{
  "name": "reisbloc-pos",
  "version": "3.7.3",
  "description": "POS Restaurante profesional con MercadoPago, UI moderna y control de inventario avanzado",
  "type": "module",
  "scripts": {
    "env": "sh scripts/check-env.sh",
    "dev": "cp .env.local .env && vite",
    "dev:functions": "cp .env.local .env && supabase functions serve",
    "dev:staging": "vite --mode staging",
    "build:staging": "vite build --mode staging",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "switch:dev": "cp .env.local .env",
    "switch:staging": "cp .env.staging .env",
    "switch:prod": "cp .env.production .env",
    "deploy:production": "bash scripts/deploy-production.sh",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@google/gemini-cli": "^0.28.2",
    "@mercadopago/sdk-react": "^1.0.7",
    "@supabase/supabase-js": "^2.93.1",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.4.1",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.294.0",
    "mercadopago": "^2.12.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.0",
    "react-router-dom": "^6.20.1",
    "recharts": "^3.7.0",
    "tailwindcss": "^3.3.6",
    "web-push": "^3.6.7",
    "zustand": "^4.4.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "autoprefixer": "^10.4.23",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "supabase": "^2.72.8",
    "tar": "^7.5.7",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.21.1"
  },
  "overrides": {
    "tar": "^7.5.7",
    "glob": "^10.4.5"
  }
}