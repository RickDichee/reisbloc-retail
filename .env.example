# .env.example (PLANTILLA - REISBLOC RETAIL)
# Copia este archivo a .env.local y completa con tus llaves reales.

# 🌐 Configuración de Supabase (Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_ENVIRONMENT=development
VITE_ORG_ID=test-org-1

# 🧠 Variables SOLO servidor (Edge Functions / API / Vercel / CI)
# ⚠️ Nunca exponer secretos con prefijo VITE_*
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT_SECRET: Genera una cadena aleatoria de 32+ caracteres
JWT_SECRET=your_jwt_secret_here
CLIP_API_KEY=replace_with_server_side_clip_api_key
CLIP_API_SECRET=replace_with_server_side_clip_api_secret
CLIP_PINPAD_SERIAL=replace_with_registered_clip_terminal_serial
CLIP_WEBHOOK_URL=https://your_project_ref.supabase.co/functions/v1/clip-webhook

# 📧 Servicio de Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_password_de_aplicacion
SMTP_FROM=tu_correo@gmail.com

# 🤖 Agentes IA y Pagos
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CONEKTA_PRIVATE_KEY=your_conekta_private_key_here
VITE_MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key_here
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token_here
MERCADOPAGO_URL=https://api.mercadopago.com

# 🔐 Crypto (Solana) Pagos
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_PAYMENT_WALLET=your_solana_wallet_address_here

# 💬 WhatsApp Bot
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
DIFY_API_URL=http://localhost/v1
DIFY_API_KEY=your_dify_api_key_here

# ⚙️ Feature Flags
VITE_ENABLE_DEBUG=false
VITE_SKIP_MAC_VALIDATION=false