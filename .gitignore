# =============================================================================
# REISBLOC RETAIL - .gitignore
# =============================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build output ---
dist/
build/
out/
dev-dist/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Runtime data ---
pids/
*.pid
*.seed
*.pid.lock

# --- Coverage & testing ---
coverage/
lib-cov/

# --- Environment variables (CRITICAL - never commit) ---
.env
.env.local
.env.staging
.env.production
.env.development.local
.env.test.local
.env.production.local

# --- IDE & system files ---
.DS_Store
.vscode/
.idea/
*.code-workspace
.gemini/

# --- Mobile build artifacts ---
*.apk
*.aar
*.ipa
*.hprof
.gradle/

# --- Supabase ---
supabase/.temp/
supabase/snippets/

# --- SQL & database ---
*.sql
MEMENTO*.sql
SHARED_DB_PROTOCOL.md

# --- Package artifacts ---
*.deb

# --- Scripts & configs (local only) ---
fixnpm.sh
.pre-commit.sh
.check-env.sh

# --- Internal documentation (sensitive / strategic) ---
docs/MEMENTO.md
irreversible.md
MOROLEON_LAUNCH_GUIDE.md
PRODUCTION_CHECKLIST.md
AUDITORIA_TECNICA.md
PRICING_STRATEGY.md
TECNICA.md
MASTER_PLAN.md
*ESTRATEGY*.md
*MONETIZACION*.md
*TOKEN*.md
*TRANSPARENCIA*.md
*PROTECCION_DATOS*.md
*DEUDA_TECNICA*.md
*ESTADO_PROYECTO*.md
*KEY_ROTATION*.md
*SISTEMA_ALERTAS*.md
*PLAYBOOK*.md
*FEEDBACK_EXPERTO*.md
*REVISION_PROFUNDA*.md
*REPORTE_TECNICO*.md
